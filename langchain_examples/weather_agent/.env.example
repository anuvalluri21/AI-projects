# Copy to .env in this folder, then fill in your email provider settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Optional contact information helps NWS identify your application.
NWS_USER_AGENT=HaymarketWeatherEmail/1.0
LATITUDE=38.8121
LONGITUDE=-77.6364
