PINECONE_API_KEY=replace_me
# Existing dense index with dimension 1024 and cosine metric
PINECONE_INDEX_HOST=https://replace-with-your-index-host.svc.region.pinecone.io
NEO4J_URI=neo4j+s://replace-me.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# Optional shorter model cache path on Windows
# EMBEDDING_CACHE_DIR=C:/path/to/short/model_cache
